{
    "compilerOptions": {
        "module"   :  "CommonJS",           // Module system
        "target"   :  "ES5",                // JavaScript version to compile to
        "strict"   :  true,                 // Enable strict type checking
        "outDir"   :  "./static",           // Output directory
        "sourceMap":  true,
        "lib"      : ["ES2015.Core","DOM"],
        // "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
